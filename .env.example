# 실제 값은 .env 파일에만 적고 절대 커밋하지 마세요.
# 자동 실행(GitHub Actions)에서는 같은 이름으로 GitHub Secrets에 등록합니다.
# 크롬 확장 프로그램은 이 파일을 쓰지 않습니다. API 키는 확장 설정 화면에 직접 넣습니다.

# Gemini API
GEMINI_API_KEY=
# 사용할 모델 (비우면 gemini-2.5-flash)
GEMINI_MODEL=

# Google Calendar
GOOGLE_CALENDAR_ID=

# 새 공지 이메일 알림 (선택)
ALERT_EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
